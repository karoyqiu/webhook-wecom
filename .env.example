# 企业微信自建应用（必填）；不要提交真实配置。
WECOM_CORP_ID=your-corp-id
WECOM_AGENT_ID=1000002
WECOM_SECRET=your-app-secret

# 接收人至少填写一种；多个值用 | 分隔。@all 可投递给全部成员。
WECOM_TO_USER=your-user-id
WECOM_TO_PARTY=
WECOM_TO_TAG=

# 默认只监听本机。前置 HTTPS 反向代理时保持代理目标一致。
LISTEN_ADDR=127.0.0.1:8080
# 仅测试时修改为假服务器的 HTTP 地址；生产保留 HTTPS 官方地址。
WECOM_API_BASE=https://qyapi.weixin.qq.com

# 留空会禁用对应来源端点。Gitea 原生 webhook 的共享密钥。
GITEA_WEBHOOK_SECRET=
# 后续来源预留，目前尚未实现。
ATLAS_WEBHOOK_SECRET=
NTFY_TOKEN=
